{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Earnings Interpretation Research Gate",
  "type": "object",
  "required": [
    "mode",
    "market",
    "report_type",
    "company_ir_domain",
    "expanded_scope_authorized",
    "workflow",
    "official_documents",
    "comparison_policy",
    "retrieval_log",
    "tool_usage",
    "enrichment_decision",
    "mcp_fields",
    "reconciliations"
  ],
  "properties": {
    "mode": {
      "enum": ["brief", "standard", "deep", "preview", "update"]
    },
    "market": {
      "enum": ["A", "HK", "US", "OTHER"]
    },
    "report_type": {
      "type": "string",
      "minLength": 1
    },
    "company_ir_domain": {
      "type": "string"
    },
    "expanded_scope_authorized": {
      "type": "boolean"
    },
    "workflow": {
      "type": "object",
      "required": ["current_state", "target", "stop_reason"],
      "properties": {
        "current_state": {
          "enum": [
            "TARGET_DEFINED",
            "LOCATING",
            "VERIFIED",
            "READ_COMPLETE",
            "ANALYSIS_READY",
            "ENRICHMENT_DECISION",
            "DONE"
          ]
        },
        "target": {
          "type": "object",
          "required": [
            "company_name",
            "security_code",
            "report_period"
          ],
          "properties": {
            "company_name": { "type": "string", "minLength": 1 },
            "security_code": { "type": "string", "minLength": 1 },
            "report_period": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "stop_reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "official_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "document_type",
          "role",
          "report_period",
          "publication_date",
          "read_status"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "document_type": {
            "enum": [
              "annual_report",
              "interim_report",
              "quarterly_report",
              "results_announcement"
            ]
          },
          "role": {
            "enum": ["current", "comparison", "supplementary"]
          },
          "report_period": { "type": "string", "minLength": 1 },
          "publication_date": { "type": "string", "minLength": 1 },
          "read_status": {
            "enum": ["success", "failed"]
          }
        },
        "additionalProperties": false
      }
    },
    "comparison_policy": {
      "type": "object",
      "required": ["income_statement", "balance_sheet"],
      "properties": {
        "income_statement": {
          "const": "official_native_comparative"
        },
        "balance_sheet": {
          "const": "official_report_opening"
        }
      },
      "additionalProperties": false
    },
    "retrieval_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "channel",
          "purpose",
          "target",
          "result",
          "state_before",
          "state_after",
          "progress"
        ],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "channel": {
            "enum": [
              "web_search",
              "web_fetch",
              "official_locator",
              "shell_network",
              "browser_use",
              "financial_mcp",
              "news_mcp"
            ]
          },
          "purpose": {
            "enum": [
              "locate_official_document",
              "read_official_document",
              "enrich_data_gap"
            ]
          },
          "target": { "type": "string", "minLength": 1 },
          "result": {
            "enum": ["success", "failed"]
          },
          "state_before": {
            "enum": [
              "TARGET_DEFINED",
              "LOCATING",
              "VERIFIED",
              "READ_COMPLETE",
              "ANALYSIS_READY",
              "ENRICHMENT_DECISION",
              "DONE"
            ]
          },
          "state_after": {
            "enum": [
              "TARGET_DEFINED",
              "LOCATING",
              "VERIFIED",
              "READ_COMPLETE",
              "ANALYSIS_READY",
              "ENRICHMENT_DECISION",
              "DONE"
            ]
          },
          "progress": { "type": "boolean" },
          "candidate_url": { "type": "string" },
          "official_document_id": { "type": "string" },
          "data_gap_id": { "type": "string" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "tool_usage": {
      "type": "object",
      "required": [
        "web_search_count",
        "web_fetch_count",
        "official_locator_count",
        "shell_network_count",
        "browser_use_count",
        "package_install_count",
        "ad_hoc_retrieval_script_count",
        "official_documents_read",
        "financial_mcp_count",
        "news_mcp_count",
        "elapsed_seconds",
        "todo_write_used",
        "company_profile_used",
        "market_valuation_used",
        "generic_news_search_used",
        "renderer_source_read"
      ],
      "properties": {
        "web_search_count": { "type": "integer", "minimum": 0 },
        "web_fetch_count": { "type": "integer", "minimum": 0 },
        "official_locator_count": { "type": "integer", "minimum": 0 },
        "shell_network_count": { "type": "integer", "minimum": 0 },
        "browser_use_count": { "type": "integer", "minimum": 0 },
        "package_install_count": { "type": "integer", "minimum": 0 },
        "ad_hoc_retrieval_script_count": { "type": "integer", "minimum": 0 },
        "official_documents_read": { "type": "integer", "minimum": 0 },
        "financial_mcp_count": { "type": "integer", "minimum": 0 },
        "news_mcp_count": { "type": "integer", "minimum": 0 },
        "elapsed_seconds": { "type": "number", "minimum": 0 },
        "todo_write_used": { "type": "boolean" },
        "company_profile_used": { "type": "boolean" },
        "market_valuation_used": { "type": "boolean" },
        "generic_news_search_used": { "type": "boolean" },
        "renderer_source_read": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "enrichment_decision": {
      "type": "object",
      "required": ["status", "reason", "data_gaps"],
      "properties": {
        "status": {
          "enum": ["not_needed", "needed", "completed"]
        },
        "reason": { "type": "string", "minLength": 1 },
        "data_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description", "source_type", "status"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "source_type": {
                "enum": ["financial", "news", "official", "other"]
              },
              "status": {
                "enum": ["open", "resolved", "unavailable"]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "mcp_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "data_gap_id",
          "status",
          "official_source_ids",
          "used_in"
        ],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "data_gap_id": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["official_verified", "pending"]
          },
          "value": { "type": "string" },
          "unit": { "type": "string" },
          "as_of": { "type": "string" },
          "provider": { "type": "string" },
          "official_source_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "used_in": {
            "type": "array",
            "items": {
              "enum": [
                "title",
                "headline",
                "executive_summary",
                "key_metric",
                "market_snapshot",
                "section",
                "high_risk",
                "low_risk",
                "appendix"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "reconciliations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "source_ids"],
        "properties": {
          "name": {
            "enum": [
              "income_statement_comparative",
              "balance_sheet_opening",
              "cash_closing_balance"
            ]
          },
          "status": {
            "enum": ["pass", "fail", "not_applicable"]
          },
          "basis": { "type": "string" },
          "left_value": { "type": "number" },
          "right_value": { "type": "number" },
          "tolerance": { "type": "number", "minimum": 0 },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
